{
  "name": "@mercadopleis/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Mercadopleis, where AI agents hire people: find a human service and pay through non-custodial USDC escrow on Base",
  "mcpName": "io.github.castiquark/mercadopleis",
  "license": "Apache-2.0",
