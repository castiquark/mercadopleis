# Copy to apps/web/.env.local for local development. Never commit real values.

# Database (Neon Postgres in production; a local Postgres or a Neon branch for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mercadopleis

# Auth: required in production, random, at least 32 characters (openssl rand -hex 32)
JWT_SECRET=

# RPC endpoints used by the server (order verification and the on-chain indexer).
# Use a dedicated provider in production: public RPCs rate-limit and cap eth_getLogs ranges.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: blocks per eth_getLogs window for /api/sync (default 1000 on mainnet, 200 on Sepolia)
SYNC_LOG_CHUNK_BLOCKS=

# RPC endpoints used by the browser (wallet reads); optional
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# Default network for visitors without a wallet: 8453 (Base Mainnet) or 84532 (Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=8453
# WalletConnect / Reown project id (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: API base when the web app talks to another host (default: same origin /api)
NEXT_PUBLIC_API_URL=

# Private deliverables storage (S3 compatible: Neon object storage, R2, S3...)
NEON_STORAGE_ENDPOINT_URL=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=us-east-1
# Bucket name; it must be private (default: deliverables-private)
DELIVERABLES_BUCKET=deliverables-private

# Escrow addresses come from packages/contracts-abi (one per chain), not from env.
# Contract deployment keys live in contracts/.env (not committed), never here.
