# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mercadopleis

# JWT / Auth
# Required in production, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
SIWE_DOMAIN=localhost:3000

# Blockchain RPC & Contracts
# Use a dedicated provider in production (Alchemy, QuickNode, ...): the public RPCs rate-limit eth_call
# and cap eth_getLogs at 1,000 blocks. Escrow addresses come from packages/contracts-abi (per chain).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT_ADDRESS=
ARBITRATOR_ADDRESS=

# Cloud Storage (S3 / R2 compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=mercadopleis-deliveries
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
